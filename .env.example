# Baby Tracker · copy to .env and fill in with the DEV Supabase project.
# Never commit .env. Server-only variables must never get a NEXT_PUBLIC_ prefix.

# ── Database (server only) ────────────────────────────────────────────────
# App runtime (Prisma Client + @prisma/adapter-pg).
# Supabase → Connect → Transaction pooler (port 6543) + "?pgbouncer=true".
DATABASE_URL="postgresql://prisma.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI only (migrate, studio) via prisma.config.ts.
# Supabase → Connect → Session pooler (port 5432), or the direct connection on IPv6.
DIRECT_URL="postgresql://prisma.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"
# Optional in dev, required in the production deployment: Supabase root CA (PEM)
# from Database → Settings → SSL configuration. Enables full TLS verification.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"

# ── Supabase Auth and Realtime (public: shipped to the browser) ───────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"

# ── Error monitoring: Sentry, EU region only (decision 086) ──────────────
# Optional: without a DSN nothing is sent. Must be a *.ingest.de.sentry.io DSN.
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org-id>.ingest.de.sentry.io/<project-id>"
# Build only (Vercel / CI), for readable stack traces. Secret: never NEXT_PUBLIC_.
# SENTRY_PROJECT="<project-slug>"
# SENTRY_AUTH_TOKEN="<organization auth token>"

# ── App ───────────────────────────────────────────────────────────────────
# IANA zone that defines "today" and the daily summaries.
APP_TIMEZONE="Europe/Madrid"

# ── Dev seed only (npx prisma db seed) ────────────────────────────────────
# SEED_DEV_PROJECT_REF="<dev project-ref>"   # seed refuses any other project
# SEED_OWNER_USER_ID="<your auth.users.id in the dev project>"
# SEED_OWNER_NAME="Alex"
